{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bullet: Run visual (ZMQ)",
      "icon": {
        "id": "play",
        "color": "terminal.ansiGreen"
      },
      "type": "shell",
      "command": "uv run --locked bullet-visual --config config/zmq.yaml",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Subscribe to the renderer camera on 5556 and publish red-target bboxes on 5560. The target-scene launcher already starts this service."
    }
  ]
}
